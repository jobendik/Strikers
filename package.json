{
  "name": "yuka-strikers",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Strikers '26 — a fast arcade soccer game themed around the World Championship 2026, built with Three.js + Yuka.js.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sim": "vite build -c simtest/vite.config.ts && node simtest/dist/harness.mjs",
    "test": "esbuild simtest/units.ts --bundle --platform=node --format=esm --outfile=simtest/dist/units.mjs --log-level=error && node simtest/dist/units.mjs"
  },
  "dependencies": {
    "three": "^0.160.0",
    "yuka": "^0.7.8"
  },
  "devDependencies": {
    "@types/three": "0.160.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0"
  }
}
